    public static Object AIsearch(String query, String instruction, String model, float temperature, float top_p,
                                  List<String> searchDomainFilter, List<Map<String, Object>> resourceTypeFilter) {
        // 检查temperature的范围
        if (temperature <= 0 || temperature > 1) {
            throw new IllegalArgumentException("temperature must be in the range (0, 1]");
        }
        // 检查top_p的范围
        if (top_p <= 0 || top_p > 1) {
            throw new IllegalArgumentException("top_p must be in the range (0, 1]");
        }

        // 检查searchDomainFilter是否为null
        if (searchDomainFilter == null) {
            throw new IllegalArgumentException("searchDomainFilter cannot be null");
        }

        // 检查resourceTypeFilter是否为null
        if (resourceTypeFilter == null) {
            throw new IllegalArgumentException("resourceTypeFilter cannot be null");
        }

        // 检查resourceTypeFilter中的每个元素是否符合要求
        for (Map<String, Object> filterItem : resourceTypeFilter) {
            if (filterItem == null) {
                throw new IllegalArgumentException("Elements in resourceTypeFilter cannot be null");
            }
            Object topKObj = filterItem.get("top_k");
            if (topKObj == null ||!(topKObj instanceof Number)) {
                throw new IllegalArgumentException("Each item in resourceTypeFilter must have a valid 'top_k' value");
            }
            int topK = ((Number) topKObj).intValue();
            if (topK < 1 || topK > 10) {
                throw new IllegalArgumentException("top_k value in resourceTypeFilter must be in the range 1~10");
            }
        }

        // 这里只是简单返回null作为占位，实际应执行搜索逻辑并返回结果
        return null;
    }
