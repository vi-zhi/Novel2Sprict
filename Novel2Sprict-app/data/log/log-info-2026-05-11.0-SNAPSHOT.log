 null || array.length == 0) {\n            return;\n        }\n\n        for (int i = 0; i < array.length - 1; i++) {\n            for (int j = 0; j < array.length - i - 1; j++) {\n                if (array[j] > array[j + 1]) {\n                    int temp = array[j];\n                    array[j] = array[j + 1];\n                    array[j + 1] = temp;\n                }\n            }\n        }\n\n        System.out.println(\"Sorted array:\");\n        for (int num : array) {\n            System.out.print(num + \" \");\n        }\n    }\n}\n```"]
